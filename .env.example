# Example environment file. Copy to .env and adjust values.
# .env itself is gitignored — never commit real credentials.

# --- PostgreSQL credentials (consumed by docker-compose) ---
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db

# --- Application settings ---
# Simulated latency of the external transformer, in seconds (0 disables it).
# Set to e.g. 2 to make the benefit of caching visible on repeated requests.
TRANSFORMER_DELAY_SECONDS=0

# DATABASE_URL is intentionally not set here:
#   - in Docker it is assembled in docker-compose.yml from the POSTGRES_* vars
#   - running locally without it, the app falls back to a local SQLite file